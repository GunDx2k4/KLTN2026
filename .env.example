# ==============================================================================
# BadmintonClub System Environment Configuration Template (.env.example)
# Copy this file to .env and provide your secret values.
# DO NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# Database & Cache
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=BadmintonClub;Username=admin;Password=YourSecurePassword;
REDIS_CONNECTION_STRING=localhost:6379,password=YourSecurePassword

# JWT Authentication
JWT_ISSUER=http://localhost:6000
JWT_AUDIENCE=http://localhost:6000
JWT_SECRET=YourSuperSecretJwtKeyAtLeast32CharactersLong
JWT_EXPIRE_MIN=60

# Message Broker (RabbitMQ)
RABBITMQ_HOST=localhost
RABBITMQ_VHOST=l7TeamVN
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=YourSecurePassword

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=dlimibe4b
CLOUDINARY_API_KEY=924533145124796
CLOUDINARY_API_SECRET=YourCloudinaryApiSecret

# UC17 - Session Settlement
SETTLEMENT_WRITES_ENABLED=true
SETTLEMENT_DISPATCH_ENABLED=true
SETTLEMENT_PREVIEW_SIGNING_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# UC18 - Bank Reconciliation & SePay Integration
RECONCILIATION_ENABLED=true
RECONCILIATION_WRITES_ENABLED=true
RECONCILIATION_DISPATCH_ENABLED=true
RECONCILIATION_EVIDENCE_DIRECTORY=/var/lib/badmintonclub/reconciliation-evidence
SEPAY_KEY_DIRECTORY=/var/lib/badmintonclub/sepay-keys
