        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "SessionRotation": {
    "Enabled": true,
    "ManualEditingEnabled": true,
    "PersonalScheduleEnabled": true,
    "SelfPauseEnabled": true,
    "DispatchEnabled": true
  }
