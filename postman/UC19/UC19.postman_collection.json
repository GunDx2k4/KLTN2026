              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.test(\"Không ghi thu mới\",()=>pm.expect(pm.response.json().replayed).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Tạo chi có hóa đơn tùy chọn",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/v1/clubs/{{clubId}}/ledger/transactions",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "requestId",
              "value": "{{expenseRequestId}}",
              "type": "text"
            },
            {
              "key": "amount",
              "value": "{{expenseAmount}}",
              "type": "text"
            },
            {
              "key": "category",
              "value": "OTHER",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Chi nước uống sandbox",
              "type": "text"
            },
            {
              "key": "invoice",
              "type": "file",
              "src": []
            }
          ]
        }
      },
      "event": [
