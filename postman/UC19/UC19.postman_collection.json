            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set(\"expenseLedgerId\", pm.response.json().ledgerId);"
            ]
          }
        }
      ]
