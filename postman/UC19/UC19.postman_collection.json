{
  "info": {
    "name": "UC19 — Sổ quỹ mở",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 Tổng quan",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/clubs/{{clubId}}/ledger"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.test(\"Số dư và công nợ có trong response\", () => { const b=pm.response.json(); pm.expect(b).to.have.property(\"availableBalance\"); pm.expect(b).to.have.property(\"debtTotal\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Lịch sử nhóm",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/clubs/{{clubId}}/ledger/transactions?page=1&pageSize=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Khoản đóng của tôi",
      "request": {
        "method": "GET",
