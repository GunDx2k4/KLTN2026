    {
      "name": "07 Chưa đăng nhập",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/clubs/{{clubId}}/ledger",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Header khác nhóm",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Group-Id",
            "value": "00000000-0000-0000-0000-000000000001"
          }
        ],
        "url": "{{baseUrl}}/api/v1/clubs/{{clubId}}/ledger"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Trang không hợp lệ",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/clubs/{{clubId}}/ledger/transactions?page=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Phát hành nghĩa vụ",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/clubs/{{clubId}}/ledger/monthly-contributions",
        "body": {
          "mode": "raw",
          "raw": "{\"userId\":\"{{memberId}}\",\"contributionMonth\":\"{{contributionMonth}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get(\"runWrites\") !== \"true\") pm.execution.skipRequest();",
              "[\"expenseRequestId\",\"monthlyRequestId\"].forEach(k => { if (!pm.environment.get(k)) pm.environment.set(k, pm.variables.replaceIn(\"{{$guid}}\")); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) pm.environment.set(\"monthlyContributionId\", pm.response.json().monthlyContributionId);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Xác nhận thu tháng",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/clubs/{{clubId}}/ledger/monthly-contributions/{{monthlyContributionId}}/collect",
        "body": {
          "mode": "raw",
          "raw": "{\"requestId\":\"{{monthlyRequestId}}\",\"expectedAmount\":{{expectedMonthlyAmount}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get(\"runWrites\") !== \"true\") pm.execution.skipRequest();",
